# Browser-safe Supabase project configuration.
# Use the same staging project for Auth, database access and Edge Functions.
# Configure these in the frontend deployment; for local frontend development,
# copy this file to .env.local and enter the staging project's public values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy projects may provide a public anon key instead. Use only one public-key variable.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
