# Browser-safe Supabase project configuration.
# Copy this file to .env.local and use values from the selected Supabase project.
NEXT_PUBLIC_SUPABASE_URL=your_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_key

# Server-only public frontend origin used for trusted Auth redirects and Origin checks.
AUTH_SITE_URL=http://127.0.0.1:3000

# Legacy projects may provide a public anon key instead. Use only one public-key variable.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
